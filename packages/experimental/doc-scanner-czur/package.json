    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-doc-scanner": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-doc-scanner": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@types/ws": "^8.18.1"
  }
